# Приклад налаштувань середовища PortCity backend.
# Скопіюйте у .env і змініть значення. Порожнє значення (FOO=) дорівнює відсутньому.
# Значення нижче - безпечні для локальної розробки. У production (NODE_ENV=production) застосунок
# відмовляється стартувати з dev-секретами (dev-only-*), емулятором паркінгу, мок-платежами,
# SMS_PROVIDER=log, OTP_DEV_ECHO=true, STORAGE_DRIVER=memory і QUEUE_DRIVER=memory.
# Секрети в production (кожна змінна *_SECRET і *_PEPPER, зокрема модульні вебхук-секрети): щонайменше
# 32 символи і не значення за замовчуванням (dev-only-*, compose-only-*, test-only-*, будь-що з
# changeme/change-me, значення з цього файлу і docker-compose.yml). Згенерувати: openssl rand -base64 48.
# Також у production відхиляються CORS_ORIGINS=* і OTP_STATIC_CODES без ALLOW_STATIC_OTP=true.
# Спільні змінні валідує src/common/config/env.schema.ts, модульні - env-секції модулів
# (src/modules/*/**/*.config.ts); README кожного модуля описує його змінні докладніше.

# ---------------------------------------------------------------------------
# Загальні
# ---------------------------------------------------------------------------
# development | test | production.
NODE_ENV=development
# api | worker. Воркер (src/worker.ts) виставляє worker сам, змінювати не потрібно.
APP_MODE=api
# Порт HTTP API (префікс /api/v1, /health, /ready, /docs).
PORT=3000
# Порт, на якому воркер віддає лише /health і /ready.
WORKER_PORT=3001
# Адреса, яку слухає сервер.
HOST=0.0.0.0
# Довіра до reverse proxy (від неї залежить IP клієнта для rate limit, лімітів OTP і аудиту):
#   false             - проксі немає, IP = адреса сокета;
#   число N (1, 2...) - N проксі перед застосунком (балансувальник = 1, CDN + балансувальник = 2);
#   список мереж      - довіряти лише проксі з цих адрес/CIDR: 10.0.0.0/8,192.168.1.10 (а також
#                       loopback, linklocal, uniquelocal).
# Сумісність: true = 1 хоп. "Довіряти всім" не підтримується: тоді будь-який клієнт підробив би
# X-Forwarded-For і обходив ліміти. IPv6-клієнти рахуються в лімітах за мережею /64.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Читабельні логи (pino-pretty). Типово true лише в development.
LOG_PRETTY=true
# Swagger UI на /docs. Типово увімкнено скрізь, крім production.
DOCS_ENABLED=true
# Дозволені Origin для CORS через кому. Запити без Origin (мобільний застосунок) дозволені завжди.
# "*" дозволено лише поза production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# База даних (PostgreSQL 17, Prisma 6)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://portcity:portcity@localhost:5432/portcity?schema=public
# true: не підключатися до БД під час старту (тести, генерація OpenAPI без БД).
PRISMA_LAZY_CONNECT=false
# true: логувати кожен SQL-запит на рівні debug.
PRISMA_LOG_QUERIES=false

# ---------------------------------------------------------------------------
# Redis 7 і черги BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# redis | memory. memory тримає задачі в пам'яті процесу (тести, API без Redis); воркер потребує redis.
QUEUE_DRIVER=redis
# Префікс ключів BullMQ у Redis.
BULL_PREFIX=portcity
# Скільки подій outbox диспетчер бере за один прохід.
OUTBOX_BATCH_SIZE=100
# Інтервал проходу диспетчера outbox у мілісекундах.
OUTBOX_DISPATCH_EVERY_MS=5000

# ---------------------------------------------------------------------------
# Безпека і токени
# ---------------------------------------------------------------------------
# Секрет підпису access JWT (HS256) і викликів TOTP. У production: випадковий рядок від 32 символів.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Значення claim iss у токенах.
JWT_ISSUER=portcity
# Час життя access-токена учасника в секундах (типово 15 хвилин).
JWT_ACCESS_TTL_SECONDS=900
# Час життя refresh-токена в днях.
REFRESH_TOKEN_TTL_DAYS=60
# Серверні "перці" для HMAC-SHA256: коди OTP, коди ваучерів і токени змін валідатора, QR картки.
OTP_PEPPER=dev-only-otp-pepper
VOUCHER_PEPPER=dev-only-voucher-pepper
MEMBER_QR_SECRET=dev-only-member-qr-secret
# Глобальний rate limit: THROTTLE_LIMIT запитів за THROTTLE_TTL_SECONDS з однієї IP-адреси.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
# Скільки годин зберігати Idempotency-Key і збережені відповіді.
IDEMPOTENCY_TTL_HOURS=24
# Оренда ключа "у роботі" (с): поки обробник не зберіг відповідь, повтор з тим самим ключем отримує 409;
# старший за цей строк ключ вважається покинутим (запит упав) і його підхоплює повтор (5-86400).
IDEMPOTENCY_LEASE_SECONDS=120
# Скільки секунд AdminGuard довіряє закешованій відповіді "адміністратор активний, роль X"
# (0 - перевіряти БД на кожен запит). Деактивація діє на інших репліках не пізніше цього строку.
ADMIN_ACCESS_CACHE_SECONDS=30

# ---------------------------------------------------------------------------
# Сховище файлів (фото чеків, зображення): S3-сумісне або пам'ять процесу
# ---------------------------------------------------------------------------
# memory | s3. У production дозволено лише s3.
STORAGE_DRIVER=memory
# Endpoint для MinIO або іншого S3-сумісного сервісу; для AWS S3 залиште порожнім.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=portcity
# Ключі доступу. Порожні значення означають IAM-роль або інший провайдер облікових даних AWS SDK.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true для MinIO (шлях /bucket/key замість bucket.host).
S3_FORCE_PATH_STYLE=true
# Час життя presigned URL у секундах.
S3_PRESIGN_TTL_SECONDS=600
# Публічна база URL (CDN) для читання файлів; порожньо = presigned GET.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# identity: вхід за SMS-кодом, сесії, бек-офіс (src/modules/identity/identity.config.ts)
# ---------------------------------------------------------------------------
# Життя SMS-коду (с), довжина коду, кількість спроб на один код.
OTP_TTL_SECONDS=300
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Ліміт кодів на номер: OTP_PHONE_LIMIT за OTP_PHONE_WINDOW_SECONDS.
OTP_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SECONDS=600
# Ліміт кодів з однієї IP-адреси (IPv6 - з однієї мережі /64): OTP_IP_LIMIT за OTP_IP_WINDOW_SECONDS.
OTP_IP_LIMIT=10
OTP_IP_WINDOW_SECONDS=3600
# Пауза між кодами для одного номера (с); відповідь містить resendAvailableAt для зворотного відліку.
OTP_RESEND_COOLDOWN_SECONDS=60
# Скільки SMS-кодів можна надіслати на один номер за 24 години (захист від SMS pumping).
OTP_PHONE_DAILY_LIMIT=5
# Блокування номера: OTP_VERIFY_FAILURE_LIMIT неправильних кодів за OTP_VERIFY_FAILURE_WINDOW_SECONDS
# (сумарно за всіма кодами) - ні перевірки, ні нових кодів до кінця вікна (429 PC_OTP_LOCKED).
OTP_VERIFY_FAILURE_LIMIT=10
OTP_VERIFY_FAILURE_WINDOW_SECONDS=86400
# Глобальний бюджет SMS на календарну добу за Києвом (далі 503) і поріг попередження в лозі (%).
SMS_DAILY_BUDGET=5000
SMS_BUDGET_ALERT_PERCENT=80
# М'які пороги капчі: від стількох кодів на номер за 24 год або з IP-мережі за вікно IP запит має
# пройти CaptchaVerifierPort (зараз noop-адаптер, пропускає все). 0 - поріг вимкнено.
OTP_CAPTCHA_PHONE_THRESHOLD=3
OTP_CAPTCHA_IP_THRESHOLD=5
# true: повертати код у відповіді POST /auth/otp/request (лише локальна розробка; заборонено в production).
OTP_DEV_ECHO=false
# Демо-номери з фіксованим кодом без SMS (рецензія в сторах): "+380501234567:123456,+380671112233:654321".
# У production відхиляються, якщо не ALLOW_STATIC_OTP=true, і тоді коди мають бути 8-значні.
OTP_STATIC_CODES=
ALLOW_STATIC_OTP=false
# log (код пишеться в лог; заборонено в production) | turbosms.
SMS_PROVIDER=log
# TurboSMS: токен (обов'язковий при SMS_PROVIDER=turbosms), альфа-ім'я, адреса API, таймаут (мс).
TURBOSMS_TOKEN=
TURBOSMS_SENDER=PortCity
TURBOSMS_API_URL=https://api.turbosms.ua/message/send.json
TURBOSMS_TIMEOUT_MS=5000
# Життя admin access-токена (с, типово 8 год, refresh-токенів для бек-офісу немає).
ADMIN_ACCESS_TTL_SECONDS=28800
# Строк дії виклику TOTP під час входу і setup-токена TOTP (с).
ADMIN_CHALLENGE_TTL_SECONDS=300
ADMIN_TOTP_SETUP_TTL_SECONDS=600
# Підпис у застосунку-автентифікаторі і допуск розбіжності годинників (с, 30 = один крок).
ADMIN_TOTP_ISSUER=PortCity Admin
ADMIN_TOTP_TOLERANCE_SECONDS=30
# Ролі, яким вхід без TOTP заборонено (через кому; none - вимкнути). Без налаштованого TOTP такий
# адміністратор отримує 403 PC_ADMIN_TOTP_SETUP_REQUIRED і налаштовує TOTP під час входу.
ADMIN_REQUIRE_TOTP_ROLES=owner,manager
# Скільки кодів можна ввести за одним викликом TOTP (виклик ще й одноразовий).
ADMIN_TOTP_CHALLENGE_MAX_ATTEMPTS=5
# Блокування адміністратора: після ADMIN_LOGIN_LOCK_THRESHOLD невдалих входів поспіль - пауза
# ADMIN_LOGIN_LOCK_BASE_SECONDS, далі вдвічі довша на кожну наступну невдачу, до MAX; лічильник
# починається заново, якщо попередня невдача старша за ADMIN_LOGIN_FAILURE_WINDOW_SECONDS.
ADMIN_LOGIN_LOCK_THRESHOLD=5
ADMIN_LOGIN_LOCK_BASE_SECONDS=300
ADMIN_LOGIN_LOCK_MAX_SECONDS=3600
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=86400
# Сплеск невдалих входів з однієї IP-мережі: стільки за вікно (с) - попередження в лозі й аудит.
ADMIN_LOGIN_BURST_THRESHOLD=20
ADMIN_LOGIN_BURST_WINDOW_SECONDS=600
# Вартість scrypt для нових паролів адміністраторів (log2 N; 17 = 128 МіБ, у production не менше 17).
ADMIN_PASSWORD_SCRYPT_LOG_N=17
# Скільки перевірок пароля виконується одночасно і скільки чекає в черзі; решта - 429 PC_ADMIN_LOGIN_BUSY.
ADMIN_SCRYPT_MAX_CONCURRENT=4
ADMIN_SCRYPT_MAX_QUEUE=16
# Бонуси за профіль (0-1000): за кожне поле, заповнене вперше, і за повністю заповнений профіль.
# Одні й ті самі змінні читають identity (показує в profileCompletion у GET /me) і club (нараховує
# за user.profile_field_completed), тому показане й нараховане не розходяться.
PROFILE_BONUS_PER_FIELD=10
PROFILE_BONUS_COMPLETE=20
# Поточні тексти згод для GET /legal/documents; otp/verify і /me/consents без версії беруть ці.
LEGAL_PROGRAM_VERSION=2026-10
LEGAL_PROGRAM_URL=https://portcity.com.ua/loyalty/rules
LEGAL_MARKETING_VERSION=2026-10
LEGAL_MARKETING_URL=https://portcity.com.ua/loyalty/marketing-consent
LEGAL_PROFILING_VERSION=2026-10
LEGAL_PROFILING_URL=https://portcity.com.ua/loyalty/profiling-consent
LEGAL_PRIVACY_POLICY_URL=https://portcity.com.ua/privacy
# Розклад щоденної задачі видалення акаунтів (cron, Europe/Kyiv) і розмір партії.
ACCOUNT_DELETION_CRON=15 4 * * *
ACCOUNT_DELETION_BATCH_SIZE=100
# Період охолодження DELETE /me у днях (відповідь містить executeAfter).
ACCOUNT_DELETION_GRACE_DAYS=30
# Скільки днів зберігати OTP-виклики і прострочені/відкликані refresh-токени.
OTP_RETENTION_DAYS=7
REFRESH_RETENTION_DAYS=60

# ---------------------------------------------------------------------------
# content: інформація про ТРЦ (GET /mall/info) і довідник орендарів
# ---------------------------------------------------------------------------
MALL_NAME=Порт City
# Адреса ТРЦ. (вул. Сухомлинського, 1 - лише додаткова паркувальна локація з правил оператора.)
MALL_ADDRESS=просп. Соборності, 43, Луцьк
MALL_HOURS=10:00-22:00
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Сайт ТРЦ у GET /mall/info.
MALL_WEBSITE=https://portcity.com.ua
# Години роботи паркінгу (довідково; тариф і правила - у модулі parking).
MALL_PARKING_UNDERGROUND_HOURS=08:00-21:00
MALL_PARKING_SURFACE_HOURS=05:00-24:00
# База URL логотипів орендарів; порожньо = S3_PUBLIC_BASE_URL.
MALL_LOGO_BASE_URL=

# ---------------------------------------------------------------------------
# receipts: подання чеків і фото (src/modules/receipts/receipts.config.ts)
# ---------------------------------------------------------------------------
# Максимальний розмір фото чека в байтах (не більше 5 МБ).
RECEIPTS_PHOTO_MAX_BYTES=5242880
# Час життя presigned PUT для фото і підписаних посилань на перегляд (с, 60-3600: фото чеків
# приватні, посилання на них не довші за годину).
RECEIPTS_PHOTO_UPLOAD_TTL_SECONDS=600
RECEIPTS_PHOTO_URL_TTL_SECONDS=900
# Через скільки хвилин незавершений чек повертає в чергу задача sweep.
RECEIPTS_STUCK_AFTER_MINUTES=5
# Утримання на перевірку: автоматично схвалені QR-чеки нових акаунтів (молодших за
# RECEIPTS_NEW_ACCOUNT_DAYS днів) або на суму понад RECEIPTS_FAST_TRACK_MAX_KOPECKS копійок (500 грн)
# нараховуються як очікувані бали на RECEIPTS_VERIFY_HOLD_HOURS годин (0 - утримання вимкнено).
RECEIPTS_VERIFY_HOLD_HOURS=24
RECEIPTS_NEW_ACCOUNT_DAYS=30
RECEIPTS_FAST_TRACK_MAX_KOPECKS=50000
# Скільки балів на добу (за Києвом) учасник отримує за автоматично схвалені QR-чеки; понад це - модерація.
RECEIPTS_DAILY_POINTS_CAP=150

# ---------------------------------------------------------------------------
# rewards: ваучери і валідатори на касах (src/modules/rewards/rewards.config.ts)
# ---------------------------------------------------------------------------
# Строк дії ваучера, купленого за бали (днів).
REWARDS_VOUCHER_TTL_DAYS=30
# Спроб знайти вільний 6-символьний код активації.
REWARDS_CODE_MAX_ATTEMPTS=8
# Розмір пакета щохвилинної задачі vouchers-expire.
REWARDS_SWEEP_BATCH_SIZE=500
# Тривалість зміни валідатора після введення PIN (год).
VALIDATOR_SHIFT_HOURS=12
# Повертати бали за ваучер, куплений за бали, якщо він згорів невикористаним (true | false).
REWARDS_REFUND_ON_EXPIRY=true

# ---------------------------------------------------------------------------
# parking: оператор паркінгу, сесії, нагадування (src/modules/parking/parking.config.ts)
# ---------------------------------------------------------------------------
# emulator (демо-оператор у процесі; заборонено в production) | vendor (заглушка реального оператора, усе 503).
PARKING_PROVIDER=emulator
# Стадія демо-сценарію (канон дизайну: в'їзд 14:00, безкоштовно до 14:30, 60 грн о 15:20,
# оплачено до 16:00, виїзд 15:52): free | payable | paid | closed. Те саме значення читає seed.
PARKING_EMULATOR_SCENARIO=payable
# today: часова лінія на сьогодні за Києвом (як seed) | now: зсув, щоб "зараз" було моментом сценарію.
PARKING_EMULATOR_ANCHOR=today
# Демо-номер, який показує емулятор (seed: AC1234BC).
PARKING_EMULATOR_PLATE=AC1234BC
# Майбутній адаптер реального оператора.
PARKING_VENDOR_BASE_URL=
PARKING_VENDOR_API_KEY=
# HMAC-SHA256 для заголовка X-Parking-Signature вебхука оператора (dev-значення заборонене в production).
PARKING_WEBHOOK_SECRET=dev-only-parking-webhook-secret
# Інтервал задачі parking-sync і "свіжість" локальної копії сесії (мс).
PARKING_SYNC_EVERY_MS=60000
PARKING_SESSION_STALE_MS=60000
# Квота запитів сесій неверифікованих номерів на учасника за годину.
PARKING_UNVERIFIED_LOOKUPS_PER_HOUR=10
# Скільки авто може мати учасник.
PARKING_MAX_VEHICLES=5
# Через скільки годин закриваються забуті таймери і сесії, яких не знає оператор.
PARKING_SESSION_TTL_HOURS=24
# Інформаційний режим, якщо рядка прапорця parking.info_mode немає.
PARKING_INFO_MODE_DEFAULT=true
# true: таймери інформаційного режиму теж публікують події outbox.
PARKING_INFO_TIMER_EVENTS=false
# Нагадування: за скільки хвилин до кінця безкоштовного часу і до кінця оплаченої години.
PARKING_FREE_ENDING_REMINDER_MINUTES=5
PARKING_EXIT_REMINDER_MINUTES=10
# Вікно безкоштовного виїзду під час повітряної тривоги (хв; прапорець parking.air_raid).
PARKING_AIR_RAID_FREE_EXIT_MINUTES=30
# Скільки годин герой показує закриту сесію.
PARKING_RECENT_CLOSED_HOURS=2
# Deep link після оплати паркінгу; порожньо = PAYMENTS_RETURN_URL.
PARKING_PAYMENT_RETURN_URL=
# Якщо до кінця поточної години лишається менше стількох хвилин, оплата купує й наступну годину
# (щоб учасник встиг виїхати; 0 - вимкнено, до 30).
PARKING_PAY_MIN_MINUTES_LEFT=5

# ---------------------------------------------------------------------------
# payments: платіжний провайдер (src/modules/payments/payments.config.ts)
# ---------------------------------------------------------------------------
# mock (лише розробка; заборонено в production) | liqpay | mono | wayforpay | fondy | portmone.
PAYMENTS_PROVIDER=mock
# HMAC-SHA256 для заголовка X-Mock-Signature мок-вебхуків (dev-значення заборонене в production).
PAYMENTS_MOCK_WEBHOOK_SECRET=dev-only-payments-mock-webhook-secret
# База checkoutUrl мок-провайдера (сторінка /api/v1/mock-checkout/:providerRef).
PAYMENTS_MOCK_CHECKOUT_BASE_URL=http://localhost:3000/api/v1/mock-checkout
# Deep link після checkout, якщо модуль-ініціатор не передав свого.
PAYMENTS_RETURN_URL=portcity://payments/return
# Вік відкритого платежу для звіряння (хв) і скільки платежів перевіряє один запуск.
PAYMENTS_PENDING_TIMEOUT_MINUTES=20
PAYMENTS_RECONCILE_BATCH=200
# Фіскалізація: none | mock (фейковий чек у розробці).
PAYMENTS_FISCALIZATION=none
PAYMENTS_MOCK_FISCAL_BASE_URL=http://localhost:3000/mock-fiscal
# Реальні адаптери відхиляють вебхуки з міткою часу, старшою за стільки секунд (захист від повтору).
PAYMENTS_WEBHOOK_MAX_AGE_SECONDS=600
# Продавець на екрані квитанції (GET /payments/:id): для непаркувальних платежів і для паркінгу
# (оператор паркінгу, ФОП, який отримує кошти).
PAYMENTS_MERCHANT_NAME=ТРЦ «Порт City»
PAYMENTS_PARKING_MERCHANT_NAME=Оператор паркінгу ТРЦ «Порт City» (ФОП)
# HMAC-секрет QR для оператора на квитанції паркінгу (operatorQrPayload); dev-значення заборонене в production.
PAYMENTS_RECEIPT_QR_SECRET=dev-only-payments-receipt-qr-secret

# ---------------------------------------------------------------------------
# notifications: push, нагадування і пошта (src/modules/notifications/services/notifications.config.ts,
# services/mail/mail.config.ts)
# ---------------------------------------------------------------------------
# stub (лог і пам'ять, у розробці) | fcm (Firebase Cloud Messaging HTTP v1).
PUSH_PROVIDER=stub
# Firebase: id проєкту і JSON сервісного акаунта (сирий або base64) або статичний токен для експериментів.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_ACCESS_TOKEN=
FCM_ENDPOINT=https://fcm.googleapis.com
FCM_TIMEOUT_MS=10000
# Спроб доставки на пару повідомлення-пристрій.
PUSH_MAX_ATTEMPTS=3
# За скільки годин нагадувати про квиток на подію і про кінець дії ваучера.
NOTIFICATIONS_TICKET_REMINDER_HOURS=24
NOTIFICATIONS_VOUCHER_EXPIRING_HOURS=24
# Пошта (лист про нове звернення в підтримку йде на SUPPORT_EMAIL): log (лист лише в лозі) |
# smtp (адаптер ще не реалізовано: застосунок відмовиться стартувати).
MAIL_PROVIDER=log
# Адреса відправника листів.
MAIL_FROM=Порт City <no-reply@portcity.local>

# ---------------------------------------------------------------------------
# Seed (лише prisma/seed.ts)
# ---------------------------------------------------------------------------
# Облікові дані записуються лише під час створення рядка: повторний seed не змінює пароль, роль,
# активність і TOTP адміністратора, PIN, ключ і активність валідатора.
# З NODE_ENV=production seed відмовляється працювати без SEED_ADMIN_PASSWORD, SEED_VALIDATOR_KEY і
# SEED_VALIDATOR_PIN або зі значеннями за замовчуванням.
# Пароль адміністратора admin@portcity.local (у development типово ChangeMe-2026!, seed друкує
# попередження; у production обов'язковий, від 12 символів).
SEED_ADMIN_PASSWORD=
# Base32-секрет TOTP адміністратора для демо-стенда (лише development; у production seed відмовить).
# Порожньо: owner налаштовує TOTP застосунком-автентифікатором під час першого входу.
SEED_ADMIN_TOTP_SECRET=
# Ключ і PIN (6-12 цифр) демо-валідатора "Aroma Kava, каса 1" (у development типово
# dev-validator-aroma-kava і 246813; у production обов'язкові, ключ від 32 випадкових символів).
SEED_VALIDATOR_KEY=
SEED_VALIDATOR_PIN=
