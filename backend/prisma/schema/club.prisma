// Club module: loyalty accounts, append-only points ledger, FIFO expiry buckets and versioned rule sets.

enum PointsTxType {
  earn
  welcome
  spend
  hold
  release
  expire
  adjust
  reverse
  refund
}

enum PointsTxState {
  pending
  available
  spent
  expired
  cancelled
}

enum PointsSourceType {
  receipt
  redemption
  manual
  promo
  event
  parking
  system
}

/// One account per member. Cached balances are updated in the same transaction as the ledger row
/// under SELECT ... FOR UPDATE on this row; a nightly job recomputes them from the ledger and reports drift.
model LoyaltyAccount {
  id                String    @id @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  availableBalance  Int       @default(0) @map("available_balance")
  pendingBalance    Int       @default(0) @map("pending_balance")
  lifetimeEarned    Int       @default(0) @map("lifetime_earned")
  /// Spending is blocked until this moment for newcomers (newcomerLockHours in the rule set).
  newcomerLockUntil DateTime? @map("newcomer_lock_until") @db.Timestamptz(6)
  /// Which welcome bonuses were granted: { "register": true, "profile": false, "firstReceipt": false }.
  welcomeState      Json      @default("{}") @map("welcome_state")
  /// points.expiring reminders already published: { "2026-12-01": [30, 7] } (Kyiv bucket day ->
  /// days-left thresholds); past days are pruned on every write.
  expiryReminders   Json      @default("{}") @map("expiry_reminders")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions      PointsTransaction[]
  expiryBuckets     PointsExpiryBucket[]
  manualAdjustments ManualAdjustment[]

  @@map("loyalty_accounts")
}

/// Append-only ledger. A trigger in the init migration rejects DELETE and any UPDATE that touches a column
/// other than state or moves state backwards. No updatedAt on purpose. CHECK (amount <> 0) in the migration.
model PointsTransaction {
  id             String           @id @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  type           PointsTxType
  state          PointsTxState
  /// Signed amount in points.
  amount         Int
  sourceType     PointsSourceType @map("source_type")
  /// Id of the receipt, redemption, manual adjustment, promo, event or parking session behind the row.
  sourceId       String?          @map("source_id") @db.Uuid
  idempotencyKey String?          @unique @map("idempotency_key") @db.VarChar(255)
  /// When a held (pending) row becomes available.
  availableAt    DateTime?        @map("available_at") @db.Timestamptz(6)
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz(6)
  reason         String?
  /// Back-office user behind a manual row; null for system rows.
  createdById    String?          @map("created_by_id") @db.Uuid
  /// History display data written once at posting time (null on rows posted before it existed).
  /// The append-only trigger compares the whole row, so these columns can never be updated.
  title          String?          @db.VarChar(200)
  subtitle       String?          @db.VarChar(300)
  /// { tenantId?, tenantName?, receiptId?, receiptTotalKopecks?, rewardId?, rewardTitle?, voucherId? }
  counterparty   Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  account          LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy        AdminUser?              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  receipt          Receipt?
  redemption       Redemption?
  manualAdjustment ManualAdjustment?
  spendAllocations PointsSpendAllocation[]

  @@index([accountId, createdAt(sort: Desc)])
  @@index([state, expiresAt])
  @@index([sourceType, sourceId])
  @@map("points_transactions")
}

/// Expiry buckets consumed by one debit row (spend, negative adjust, reverse): a refund of that
/// row puts the points back into the same buckets with their original expiry. Written once in
/// the debit's transaction; CHECK (amount > 0) in docs/pending-sql/club-rewards.sql.
model PointsSpendAllocation {
  spendTxId String   @map("spend_tx_id") @db.Uuid
  /// Kyiv calendar day of the bucket the points were taken from.
  expiresOn DateTime @map("expires_on") @db.Date
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  spendTx PointsTransaction @relation(fields: [spendTxId], references: [id], onDelete: Restrict)

  @@id([spendTxId, expiresOn])
  @@map("points_spend_allocations")
}

/// Remaining available points per expiry day, so FIFO spend and expiry touch O(buckets) rows.
model PointsExpiryBucket {
  accountId String   @map("account_id") @db.Uuid
  expiresOn DateTime @map("expires_on") @db.Date
  remaining Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, expiresOn])
  @@index([expiresOn])
  @@map("points_expiry_buckets")
}

/// Versioned program configuration: rates, caps, hold thresholds, TTL, welcome bonuses (BRIEF section 4).
model LoyaltyRuleSet {
  id          String   @id @db.Uuid
  version     Int      @unique
  activeFrom  DateTime @map("active_from") @db.Timestamptz(6)
  config      Json
  note        String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([activeFrom])
  @@map("loyalty_rule_sets")
}
