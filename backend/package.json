{
  "name": "portcity-backend",
  "version": "0.1.0",
  "description": "PortCity loyalty backend: NestJS 12, Prisma 6, BullMQ 6, PostgreSQL 17, Redis 7",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\" \"*.{js,mjs,json}\" \"test/**/*.js\" \"docs/**/*.md\" README.md",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.ts\" \"*.{js,mjs,json}\" \"test/**/*.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --config jest.config.js",
    "test:int": "jest --config test/jest-int.config.js --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:cov": "jest --config jest.config.js --coverage",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "openapi": "nest build && node dist/scripts/openapi.js",
    "docs:api": "npm run openapi && node dist/scripts/api-md.js && prettier --write docs/API.md"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@date-fns/tz": "^1.5.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "~6.19.3",
    "bullmq": "^6.5.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.15",
    "nestjs-pino": "^5.3.1",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
